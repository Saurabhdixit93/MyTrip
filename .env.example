# ── Database ──────────────────────────────────────────────
# Neon / Supabase / any Postgres. Local without Docker: `pnpm db:dev` prints a TCP URL.
DATABASE_URL="postgresql://user:password@host/mytrip?sslmode=require"
# Optional pool cap. Leave empty for Neon/Postgres; set "1" for the local `prisma dev` database.
DATABASE_POOL_MAX=""

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Auth.js ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth (optional; the Google button is hidden when unset)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Demo sign-in without email, for local dev and e2e tests. NEVER enable on a public deployment.
AUTH_DEV_LOGIN="false"

# ── Email: magic links via SMTP (Nodemailer) ───────────────
# Gmail: smtp.gmail.com, port 465, and a Google "App password" (not your normal password).
# When SMTP_HOST is empty in dev, sign-in links are printed to the server console.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
# Gmail only allows sending as the authenticated address (or a verified alias).
EMAIL_FROM="MyTrip <you@gmail.com>"

# ── File storage (receipts, covers, UPI QR, payment proofs) ─
# "local" writes to ./.data/uploads (dev only). "s3" = any S3-compatible store (Neon, AWS, R2, MinIO).
STORAGE_DRIVER="local"
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
S3_BUCKET="mytrip"

# Let cover-image URL import fetch from localhost/private hosts. Local dev + e2e ONLY.
IMAGE_IMPORT_ALLOW_PRIVATE="false"

# If your router/ISP DNS refuses some hosts (seen with *.neon.tech), retry lookups via public DNS.
# Leave empty on Vercel. Example: "1.1.1.1,8.8.8.8"
DNS_FALLBACK_SERVERS=""

# ── Rate limiting (optional; in-memory fallback when unset) ─
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── End-to-end tests (Playwright) ─────────────────────────
# E2E starts its own server on E2E_PORT. Point E2E_DATABASE_URL at a throwaway database so test
# users/trips never land in your real one (falls back to DATABASE_URL). E2E_STORAGE_DRIVER
# overrides STORAGE_DRIVER for tests (e.g. "local").
E2E_PORT="3100"
E2E_DATABASE_URL=""
E2E_STORAGE_DRIVER="local"
# Pool size for the e2e server's DB (the local `prisma dev` database needs 1).
E2E_DATABASE_POOL_MAX="1"
