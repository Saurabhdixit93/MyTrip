# ── Database ──────────────────────────────────────────────
# Local: `pnpm db:dev` starts a Prisma Postgres dev server and prints its TCP URL.
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Auth.js ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth (optional; the Google button is hidden when unset)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Magic-link email via Resend (optional; links are printed to the server console when unset)
AUTH_RESEND_KEY=""
EMAIL_FROM="MyTrip <login@your-domain.com>"
# Demo sign-in without email, for local dev and e2e tests. NEVER enable on a public deployment.
AUTH_DEV_LOGIN="false"

# ── File storage (receipts, QR images, payment proofs) ─────
# "local" writes to ./.data/uploads (dev only). "s3" works with AWS S3, Cloudflare R2, Supabase Storage, MinIO.
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Rate limiting (optional; in-memory fallback when unset) ─
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
